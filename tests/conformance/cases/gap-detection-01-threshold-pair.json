{
  "id": "gap-detection-01-threshold-pair",
  "kind": "gap_detection",
  "description": "The per-orientation spacing trigger: a pair fires when its spacing is at least the line's orientation threshold times the line's own median spacing. Vertical fires at 1.6 and the boundary is inclusive; horizontal fires at 1.8, so a 1.7 ratio is a gap on a vertical line and not on a horizontal one. Uniform lines report nothing in either orientation.",
  "mobile_mirror": "GapDetectorTest",
  "tolerances": { "gap_ratio": 0.0001, "gap_span_px": 0.0001 },
  "case": {
    "lines": [
      {
        "text": "あいうえお",
        "is_vertical": true,
        "char_boxes": [[0, 0, 40, 20], [0, 20, 40, 20], [0, 40, 40, 20], [0, 72, 40, 20], [0, 92, 40, 20]],
        "expect": [{ "insert_at": 3, "ratio": 1.6, "span_px": 32 }]
      },
      {
        "text": "あいうえお",
        "is_vertical": true,
        "char_boxes": [[0, 0, 40, 20], [0, 20, 40, 20], [0, 40, 40, 20], [0, 74, 40, 20], [0, 94, 40, 20]],
        "expect": [{ "insert_at": 3, "ratio": 1.7, "span_px": 34 }]
      },
      {
        "text": "あいうえお",
        "is_vertical": false,
        "char_boxes": [[0, 0, 20, 40], [20, 0, 20, 40], [40, 0, 20, 40], [74, 0, 20, 40], [94, 0, 20, 40]],
        "expect": []
      },
      {
        "text": "あいうえお",
        "is_vertical": false,
        "char_boxes": [[0, 0, 20, 40], [20, 0, 20, 40], [40, 0, 20, 40], [78, 0, 20, 40], [98, 0, 20, 40]],
        "expect": [{ "insert_at": 3, "ratio": 1.9, "span_px": 38 }]
      },
      {
        "text": "あいうえお",
        "is_vertical": true,
        "char_boxes": [[0, 0, 40, 20], [0, 20, 40, 20], [0, 40, 40, 20], [0, 60, 40, 20], [0, 80, 40, 20]],
        "expect": []
      },
      {
        "text": "あいうえお",
        "is_vertical": false,
        "char_boxes": [[0, 0, 20, 40], [20, 0, 20, 40], [40, 0, 20, 40], [60, 0, 20, 40], [80, 0, 20, 40]],
        "expect": []
      }
    ]
  }
}
