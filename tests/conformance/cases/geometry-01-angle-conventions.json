{
  "id": "geometry-01-angle-conventions",
  "kind": "geometry",
  "description": "Rotated-frame conventions both sides must share: x-axis angle from +x, y-down, clockwise-positive; normalization to [-90, 90); the 1.25 vertical aspect rule with its exact boundary; the 1-degree axis-aligned rule with the short-frame quantization widening.",
  "mobile_mirror": "RotatedGeometryTest",
  "tolerances": { "angle_deg": 0.5 },
  "case": {
    "frames": [
      { "cx": 0, "cy": 0, "w": 200, "h": 40, "angle_deg": 162.0,
        "expect": { "vertical": false, "axis_aligned": false, "norm_angle_deg": -18.0 } },
      { "cx": 0, "cy": 0, "w": 200, "h": 40, "angle_deg": -100.0,
        "expect": { "vertical": false, "axis_aligned": false, "norm_angle_deg": 80.0 } },
      { "cx": 0, "cy": 0, "w": 200, "h": 40, "angle_deg": 0.5,
        "expect": { "vertical": false, "axis_aligned": true } },
      { "cx": 0, "cy": 0, "w": 200, "h": 40, "angle_deg": 5.0,
        "expect": { "vertical": false, "axis_aligned": false } },
      { "cx": 0, "cy": 0, "w": 40, "h": 200, "angle_deg": 0.0,
        "expect": { "vertical": true, "axis_aligned": true } },
      { "cx": 0, "cy": 0, "w": 100, "h": 125, "angle_deg": 0.0,
        "expect": { "vertical": true, "axis_aligned": true } },
      { "cx": 0, "cy": 0, "w": 100, "h": 124, "angle_deg": 0.0,
        "expect": { "vertical": false, "axis_aligned": true } },
      { "cx": 0, "cy": 0, "w": 20, "h": 10, "angle_deg": 3.0,
        "expect": { "vertical": false, "axis_aligned": true } },
      { "cx": 0, "cy": 0, "w": 20, "h": 10, "angle_deg": 5.0,
        "expect": { "vertical": false, "axis_aligned": false } }
    ]
  }
}
