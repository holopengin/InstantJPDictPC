{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "linkedProjects": [
          "Cargo.toml"
        ],
        "checkOnSave": true,
        "check": {
          "command": "check",
          "invocationStrategy": "once",
          "overrideCommand": [
            "cargo",
            "check",
            "--manifest-path",
            "Cargo.toml",
            "--message-format=json"
          ]
        }
      }
    }
  }
}
